{
  "name": "attic-projects-automation",
  "version": "1.0.0",
  "description": "End-to-End Automation Pipeline for Attic Projects Company using Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:all": "playwright test",
    "test:homepage": "playwright test --grep \"Homepage\"",
    "test:attic": "playwright test --grep \"Attic Cleaning\"",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:trace": "playwright test --trace on",
    "capture:baseline": "node capture-attic-cleaning.js",
    "capture:all": "ts-node src/scripts/captureBaselines.ts",
    "install:browsers": "playwright install",
    "runner": "node run-tests.js",
    "setup": "npm install && npx playwright install",
    "ci": "playwright test --reporter=github"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e",
    "typescript",
    "page-object-model",
    "attic-projects"
  ],
  "author": "Amin Nizami",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
