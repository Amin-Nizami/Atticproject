HOME_PAGE_URL=https://www.atticprojectscompany.com/
ATTIC_CLEANING_PAGE_URL=https://www.atticprojectscompany.com/services/attic-cleaning/

# Test Configuration
TEST_TIMEOUT=60000
NAVIGATION_TIMEOUT=45000
ACTION_TIMEOUT=15000
EXPECT_TIMEOUT=15000

# Browser Configuration
DEFAULT_BROWSER=chromium
HEADLESS=false
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
